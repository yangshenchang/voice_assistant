{
  "name": "dsh-qqbot-relay",
  "version": "0.1.0",
  "description": "Voice-assistant delegate relay: drives a tool-restricted dsh agent inside the qqbot profile and pushes full reports to QQ",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": { "import": "./index.js" }
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": false },
    "@deepseek-ai/schemastery": { "optional": false },
    "@deepseek-ai/dsh-agent": { "optional": false },
    "@deepseek-ai/dsh-session": { "optional": false },
    "@deepseek-ai/dsh-llm": { "optional": false }
  }
}
